{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tools-iatosh-com",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  // Custom Domain なので DNS は Cloudflare が自動で作る。
  // 各ツールは自分の Worker に tools.iatosh.com/<tool>* のルートを持ち、そちらが優先される。
  "routes": [{ "pattern": "tools.iatosh.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
